exports[`category All-work list parity > renders the fixed representative list with the shared row > dom 1`] = `"<section class="flex flex-col gap-4"><header class="flex flex-col gap-1"><h2 class="text-lg font-semibold leading-tight">Representative work across Reagents</h2><p class="text-sm text-muted-foreground">A sample of recent first/senior-authored publications across every method family here. Select a family on the left to focus on its work.</p></header><ul class="divide-y divide-border"><li class="py-4"><div class="line-clamp-2 font-semibold leading-snug"><button type="button" aria-haspopup="dialog" class="text-left hover:underline" aria-label="Fam paper 1">Fam paper 1</button></div><div class="mt-1 flex flex-wrap items-center gap-x-2 text-xs text-muted-foreground"><span class="italic">Cell</span><span aria-hidden="true">·</span><span>2023</span></div><div data-stub="author-chips" data-props="{&quot;authors&quot;:[{&quot;name&quot;:&quot;Ada Example&quot;,&quot;cwid&quot;:&quot;abc1001&quot;,&quot;slug&quot;:&quot;ada-example&quot;,&quot;identityImageEndpoint&quot;:&quot;/img/abc1001&quot;,&quot;isFirst&quot;:true,&quot;isLast&quot;:false}],&quot;pmid&quot;:&quot;1&quot;}"></div><div data-stub="meta" data-props="{&quot;citationCount&quot;:null,&quot;impactScore&quot;:40,&quot;impactJustification&quot;:null,&quot;pmid&quot;:&quot;1&quot;,&quot;pmcid&quot;:null,&quot;doi&quot;:null,&quot;lazyAbstract&quot;:true}"></div></li><li class="py-4"><div class="line-clamp-2 font-semibold leading-snug"><button type="button" aria-haspopup="dialog" class="text-left hover:underline" aria-label="Fam paper 2">Fam paper 2</button></div><div class="mt-1 flex flex-wrap items-center gap-x-2 text-xs text-muted-foreground"><span class="italic">Cell</span><span aria-hidden="true">·</span><span>2023</span></div><div data-stub="author-chips" data-props="{&quot;authors&quot;:[{&quot;name&quot;:&quot;Ada Example&quot;,&quot;cwid&quot;:&quot;abc1001&quot;,&quot;slug&quot;:&quot;ada-examp