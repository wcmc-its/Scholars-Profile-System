<?xml version="1.0" encoding="UTF-8"?>
<!--
  Small, hand-built stand-in for NLM's desc<year>.xml — see
  ../generate.golden.test.ts. Exercises every branch of the admit-exclude-
  readmit closure against the REAL, checked-in ../../../docs/cancer-taxonomy-
  ruleset.csv: root subtree inclusion, exclude-then-individual-readmit
  (Cysts/Hamartoma), a term-only inclusion outside the tree (BRCA1 Protein),
  a term-only exclusion that must NOT survive (Multiple Pulmonary Nodules),
  the experimental-model site-topic-stripping cross-list (Liver Neoplasms,
  Experimental carries two tree numbers, same as real MeSH), and
  fallback-topic-only-when-nothing-more-specific-matched (Hematologic
  Neoplasms vs. Leukemia). Every other one of the ruleset's ~154 rows will
  land in `.unresolved` against this tiny fixture — expected and asserted.
-->
<DescriptorRecordSet>
  <DescriptorRecord>
    <DescriptorUI>D001</DescriptorUI>
    <DescriptorName><String>Neoplasms</String></DescriptorName>
    <TreeNumberList><TreeNumber>C04</TreeNumber></TreeNumberList>
  </DescriptorRecord>
