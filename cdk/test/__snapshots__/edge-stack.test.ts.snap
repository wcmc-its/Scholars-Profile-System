                        "StaticAssetsBucketC3095769",
                        "Arn",
                      ],
                    },
                    "/*",
                  ],
                ],
              },
            },
          ],
          "Version": "2012-10-17",
        },
      },
      "Type": "AWS::S3::BucketPolicy",
    },
    "WcmIpAllowSet": {
      "Properties": {
        "Addresses": {
          "Ref": "SsmParameterValuespsprodedgeallowedcidrsC96584B6F00A464EAD1953AFF4B05118Parameter",
        },
        "Description": "Temporary #461 SPS front-end allowlist prod - remove after testing",
        "IPAddressVersion": "IPV4",
        "Name": "sps-edge-prod-wcm-allow",
        "Scope": "CLOUDFRONT",
      },
      "Type": "AWS::WAFv2::IPSet",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;

