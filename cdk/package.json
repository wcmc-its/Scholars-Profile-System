{
  "name": "scholars-profile-system-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for the Scholars Profile System — see docs/ADR-008-infrastructure-as-code.md.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "lambda/oncall-relay",
    "lambda/db-bootstrap-seed",
    "lambda/cf-usage-rollup"
  ],
  "scripts": {
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.276.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "aws-cdk": "2.1148.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "snapshotFormat": {
      "printBasicPrototype": false,
      "escapeString": false
    }
  }
}
